model AdmissionLead {
  id                  String          @id @default(uuid()) @db.Uuid
  instituteId         String          @map("institute_id") @db.Uuid
  createdById         String?         @map("created_by_id") @db.Uuid
  assignedCounselorId String?         @map("assigned_counselor_id") @db.Uuid
  convertedStudentId  String?         @map("converted_student_id") @db.Uuid
  name                String
  email               String?
  phone               String?
  guardianName        String?         @map("guardian_name")
  guardianPhone       String?         @map("guardian_phone")
  targetTrack         String          @map("target_track")
  source              String
  stage               LeadStage       @default(NEW)
  notes               String?
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  institute           Institute       @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  createdBy           User?           @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedCounselor   User?           @relation("LeadAssignee", fields: [assignedCounselorId], references: [id], onDelete: SetNull)
  convertedStudent    Student?        @relation(fields: [convertedStudentId], references: [id], onDelete: SetNull)
