model BankTransaction {
  id           String                @id @default(uuid()) @db.Uuid
  instituteId  String                @map("institute_id") @db.Uuid
  importedById String?               @map("imported_by_id") @db.Uuid
  paymentId    String?               @unique @map("payment_id") @db.Uuid
  reference    String
  amount       Decimal               @db.Decimal(12, 2)
  occurredAt   DateTime              @map("occurred_at") @db.Timestamptz(3)
  senderName   String?               @map("sender_name")
  source       PaymentSource
  status       BankTransactionStatus @default(UNMATCHED)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  institute    Institute             @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  importedBy   User?                 @relation(fields: [importedById], references: [id], onDelete: SetNull)
  payment      Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([instituteId, reference])
  @@index([instituteId, status, occurredAt])
  @@map("bank_transactions")
}

